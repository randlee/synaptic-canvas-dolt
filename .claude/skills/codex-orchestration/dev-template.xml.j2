<task id="{{ task_id }}">
<title>{{ task_title }}</title>

<worktree>{{ worktree_path }}</worktree>
<branch>{{ branch }}</branch>
<pr_target>{{ pr_target }}</pr_target>

<context>
{{ context }}
</context>

<deliverables>
{% for d in deliverables %}
{{ loop.index }}. {{ d }}
{% endfor %}
</deliverables>

<requirements_docs>
{% for doc in requirements_docs %}
- {{ doc }}
{% endfor %}
</requirements_docs>

<protocol>
1. ACK this task immediately via: atm send team-lead "ACK {{ task_id }}"
2. Work in the assigned worktree only.
3. Commit and push when complete.
4. Send completion: atm send team-lead "COMPLETE {{ task_id }} branch={{ branch }} sha=$(git rev-parse HEAD)"
</protocol>

<when idle="immediate" busy="after-current-task"/>
<console announce="concise" pause="false"/>
</task>
